{
  "name": "api",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc --noEmit && bun build src/index.ts --outdir dist --target bun --packages external",
    "start": "bun dist/index.js",
    "lint": "oxlint . --deny-warnings",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "lint:fix": "oxlint . --fix --deny-warnings"
  },
  "dependencies": {
    "elysia": "1.4.30",
    "@repo/schemas": "workspace:*"
  },
  "devDependencies": {
    "@elysia/eden": "^1.4.10",
    "bun-types": "latest",
    "typescript": "~5.9.3",
    "@repo/oxlint-config": "workspace:*"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  }
}
