{
  "name": "@repo/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "go run ./cmd/server",
    "build": "go build -trimpath -o dist/server ./cmd/server",
    "start": "./dist/server",
    "lint": "go vet ./...",
    "format": "gofmt -w .",
    "format:check": "test -z \"$(gofmt -l .)\""
  }
}
