{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".oxlintrc.json"],
  "globalPassThroughEnv": [
    "GOCACHE",
    "GOMODCACHE",
    "GOPATH",
    "GOROOT",
    "GOPROXY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "check-types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["API_ADDR", "API_PROXY_TARGET"]
    },
    "@repo/frontend#dev": {
      "cache": false,
      "persistent": true,
      "with": ["@repo/api#dev"],
      "passThroughEnv": ["API_PROXY_TARGET"]
    },
    "@repo/api#build": {
      "cache": false,
      "outputs": ["dist/**"],
      "env": ["GOOS", "GOARCH", "CGO_ENABLED", "GOFLAGS", "GOTOOLCHAIN"]
    },
    "@repo/api#lint": {
      "cache": false
    }
  }
}
