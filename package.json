{
  "name": "codebalt",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,html}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint:fix": "oxlint . --fix --deny-warnings"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.8"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
