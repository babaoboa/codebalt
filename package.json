{
  "name": "codebalt",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=@repo/frontend",
    "dev:api": "turbo run dev --filter=@repo/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "oxlint apps/frontend packages/ui --fix --deny-warnings",
    "check-types": "turbo run check-types",
    "check": "turbo run lint check-types build",
    "format": "prettier --write . && bun run --filter @repo/api format",
    "format:check": "prettier --check . && bun run --filter @repo/api format:check"
  },
  "devDependencies": {
    "turbo": "2.11.8",
    "oxlint": "1.88.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=24.20.0",
    "bun": ">=1.4.0"
  }
}
